# Dependências das configs deste repo. Instalado pelo install.sh via `brew bundle`.
# Regra: só entra aqui o que alguma config referencia de fato.

# Shell
brew "zsh-autosuggestions"          # plugin listado no .zshrc
brew "zsh-syntax-highlighting"      # plugin listado no .zshrc
brew "powerlevel10k"                # tema do prompt

# CLI usada por aliases e configs
brew "eza"                          # alias ls
brew "zoxide"                       # comando z
brew "fzf"                          # aliases cbr e tldrf
brew "git-delta"                    # preview do alias cbr
brew "tealdeer"                     # fornece o binário tldr
brew "kubernetes-cli"               # alias k
brew "lazygit"                      # plugin lazygit.nvim

# Busca usada pelo telescope no nvim
brew "ripgrep"
brew "fd"

# Editor, multiplexador e toolchain
brew "node"                         # o mason precisa de npm pros LSP de ts/html/css
brew "neovim"
brew "tmux"
brew "go"                           # gopls e go.nvim

# GUI e fontes
cask "wezterm"
cask "font-meslo-lg-nerd-font"
cask "font-caskaydia-cove-nerd-font"
cask "font-hack-nerd-font"
